{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "precedent",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "observability": { "enabled": true },
  // One Court per session (the coordinator) and one Associate per draft (an agent).
  "durable_objects": {
    "bindings": [
      { "name": "Court", "class_name": "Court" },
      { "name": "Associate", "class_name": "Associate" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Court", "Associate"] }],
  // Trunks and per-draft forks live in this Artifacts namespace.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "precedent", "remote": true }],
  // Drafts are cross-examined inside Dynamic Workers (one isolate per tree hash).
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "MAX_SESSIONS_PER_DAY": "40"
  }
}
